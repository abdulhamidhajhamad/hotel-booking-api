# ---- SQL Server ----
MSSQL_SA_PASSWORD=Your_strong_Passw0rd!
DB_CONNECTION=Server=localhost,1433;Database=HotelBooking;User Id=sa;Password=Your_strong_Passw0rd!;TrustServerCertificate=True;MultipleActiveResultSets=true

# ---- Redis ----
REDIS_CONNECTION=localhost:6379

# ---- JWT ----
JWT_ISSUER=HotelBooking.Api
JWT_AUDIENCE=HotelBooking.Client
JWT_SIGNING_KEY=change-me-to-a-32-byte-or-longer-random-secret
JWT_ACCESS_MINUTES=15
JWT_REFRESH_MINUTES=30

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=hotel-booking

# ---- SMTP (Mailpit in dev needs no auth, leave USERNAME/PASSWORD empty; fill from provider in prod) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=no-reply@hotelbooking.local
SMTP_FROM_NAME=Hotel Booking

# ---- Email confirmation ----
EMAIL_CONFIRM_TOKEN_LIFETIME_HOURS=24
EMAIL_CONFIRM_TOKEN_BYTE_LENGTH=32
EMAIL_CONFIRM_URL_TEMPLATE=http://localhost:3000/confirm-email#token={token}
EMAIL_CONFIRM_RESEND_COOLDOWN_SECONDS=60

# ---- Stripe (use your test key sk_test_...) ----
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key
STRIPE_CURRENCY=USD