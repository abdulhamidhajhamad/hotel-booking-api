# Copy this file to `.env` at the solution root and replace the placeholder values.
# `.env` is git-ignored; `.env.example` is checked in as a template.

# ---- Database ----

# Connection string used by the ASP.NET Core app and by `dotnet ef`.
# When the SQL Server container from docker-compose.yml is used, host is
# `localhost,1433` and the credentials match MSSQL_SA_PASSWORD below.
DB_CONNECTION=Server=localhost,1433;Database=HotelBooking;User Id=sa;Password=Your_Strong_Password_1234!;TrustServerCertificate=True;

# SA password for the SQL Server container. Must satisfy SQL Server complexity
# rules: 8+ characters, mix of upper, lower, digit, and symbol.
MSSQL_SA_PASSWORD=Your_Strong_Password_1234!
