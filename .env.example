# ---- JWT ----
JWT_ISSUER=HotelBooking.Api
JWT_AUDIENCE=HotelBooking.Client
JWT_SIGNING_KEY=change-me-to-a-32-byte-or-longer-random-secret
JWT_ACCESS_MINUTES=15
JWT_REFRESH_MINUTES=30

# ---- Redis ----
REDIS_CONNECTION=localhost:6379

# ---- SMTP (Mailpit in dev needs no auth, leave USERNAME/PASSWORD empty; fill from provider in prod) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=no-reply@hotelbooking.local
SMTP_FROM_NAME=Hotel Booking

# ---- Email confirmation ----
EMAIL_CONFIRM_TOKEN_LIFETIME_HOURS=24
EMAIL_CONFIRM_TOKEN_BYTE_LENGTH=32
EMAIL_CONFIRM_URL_TEMPLATE=http://localhost:3000/confirm-email#token={token}
EMAIL_CONFIRM_RESEND_COOLDOWN_SECONDS=60
